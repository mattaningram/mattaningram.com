---
import BaseLayout from '@layouts/BaseLayout.astro'
import Logo from '@components/Logo.astro'
import RoadBackdrop from '@components/study/RoadBackdrop.astro'
import FieldBackdrop from '@components/study/FieldBackdrop.astro'
import { Font } from 'astro:assets'

export interface Props {
  title: string
  color: string
  theme: 'road' | 'field'
  slides: Array<{ id: string; title: string }>
}

const { title, color, theme, slides } = Astro.props
---

<BaseLayout title={title} pageColor={color} class={`study-layout study-theme--${theme}`}>
  <Font slot="head" cssVariable="--font-lora" />

  {theme === 'road' ? <RoadBackdrop /> : <FieldBackdrop />}

  <nav class="study-header">
    <a class="study-home-link" href="/" aria-label="Home"><Logo size="1.5rem" /></a>
  </nav>

  <slot name="nav" />

  <main class="study-slides" data-slide-count={slides.length}>
    <slot />
  </main>
</BaseLayout>

<script>
  import { animate, stagger, inView } from 'motion'

  const cleanups: (() => void)[] = []
  const animated = new WeakSet<Element>()
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  function initStudy() {
    cleanup()

    const container = document.querySelector('.study-slides') as HTMLElement
    if (!container) return

    const sections = Array.from(container.querySelectorAll(':scope > section')) as HTMLElement[]
    const dots = document.querySelectorAll('.study-nav-dot')

    // --- Active slide tracking via IntersectionObserver ---
    // Below the md breakpoint the container is not a scroller, so the viewport
    // has to be the root instead of the (full page height) container.
    const isPaged = window.matchMedia('(min-width: 768px)').matches

    let activeIndex = -1
    const setActive = (index: number) => {
      if (index === activeIndex || index < 0) return
      activeIndex = index
      dots.forEach((dot, i) => dot.classList.toggle('active', i === index))
      document.dispatchEvent(
        new CustomEvent('study:slide', { detail: { index, total: sections.length, id: sections[index]?.id } }),
      )
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActive(sections.indexOf(entry.target as HTMLElement))
            const id = (entry.target as HTMLElement).id
            if (id) history.replaceState(null, '', `#${id}`)
          }
        }
      },
      { root: isPaged ? container : null, threshold: 0.5 },
    )

    sections.forEach((s) => observer.observe(s))
    cleanups.push(() => observer.disconnect())

    // --- Dot nav click handling (smooth scroll within container) ---
    dots.forEach((dot) => {
      const handler = (e: Event) => {
        e.preventDefault()
        const href = (dot as HTMLAnchorElement).getAttribute('href')
        if (!href) return
        const target = document.querySelector(href) as HTMLElement
        target?.scrollIntoView({ behavior: 'smooth' })
      }
      dot.addEventListener('click', handler)
      cleanups.push(() => dot.removeEventListener('click', handler))
    })

    // --- Per-slide entrance animations via inView ---
    sections.forEach((section) => {
      if (animated.has(section)) return

      if (reducedMotion) {
        // Show everything immediately
        section.querySelectorAll('.slide-heading, .slide-body, .slide-media, .slide-stagger-item').forEach((el) => {
          ;(el as HTMLElement).style.opacity = '1'
        })
        animated.add(section)
        return
      }

      const stop = inView(
        section,
        () => {
          if (animated.has(section)) return
          animated.add(section)
          animateSlide(section)
        },
        { amount: 0.25 },
      )
      cleanups.push(stop)
    })

    // --- Keyboard navigation ---
    const onKeyDown = (e: KeyboardEvent) => {
      // Don't intercept if user is in an input or modifier keys are pressed
      if (e.target !== document.body || e.metaKey || e.ctrlKey) return

      let currentIndex = 0
      for (let i = 0; i < sections.length; i++) {
        const rect = sections[i].getBoundingClientRect()
        const containerRect = container.getBoundingClientRect()
        if (rect.top >= containerRect.top - 10) {
          currentIndex = i
          break
        }
      }

      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
        e.preventDefault()
        const next = Math.min(currentIndex + 1, sections.length - 1)
        sections[next]?.scrollIntoView({ behavior: 'smooth' })
      } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
        e.preventDefault()
        const prev = Math.max(currentIndex - 1, 0)
        sections[prev]?.scrollIntoView({ behavior: 'smooth' })
      }
    }
    document.addEventListener('keydown', onKeyDown)
    cleanups.push(() => document.removeEventListener('keydown', onKeyDown))

    // --- Handle initial hash ---
    const hash = window.location.hash
    if (hash) {
      const target = document.querySelector(hash) as HTMLElement
      if (target && sections.includes(target)) {
        requestAnimationFrame(() => target.scrollIntoView({ behavior: 'instant' }))
      }
    }
  }

  function animateSlide(section: HTMLElement) {
    const easing: [number, number, number, number] = [0.22, 1, 0.36, 1]

    const heading = section.querySelector('.slide-heading') as HTMLElement
    const bodies = section.querySelectorAll('.slide-body')
    const media = section.querySelector('.slide-media') as HTMLElement
    const items = section.querySelectorAll('.slide-stagger-item')

    if (heading) {
      animate(heading, { opacity: [0, 1], y: [24, 0] } as any, { duration: 0.6, easing } as any)
    }

    if (bodies.length > 0) {
      animate(
        bodies,
        { opacity: [0, 1], y: [16, 0] } as any,
        { duration: 0.6, delay: stagger(0.1, { start: 0.15 } as any), easing } as any,
      )
    }

    if (media) {
      animate(
        media,
        { opacity: [0, 1], y: [20, 0], scale: [0.97, 1] } as any,
        { duration: 0.7, delay: 0.25, easing } as any,
      )
    }

    if (items.length > 0) {
      animate(
        items,
        { opacity: [0, 1], y: [12, 0] } as any,
        { duration: 0.4, delay: stagger(0.1, { start: 0.2 } as any), easing } as any,
      )
    }
  }

  function cleanup() {
    cleanups.forEach((fn) => fn())
    cleanups.length = 0
  }

  // Init on load and Astro view transitions
  initStudy()
  document.addEventListener('astro:after-swap', initStudy)
  document.addEventListener('astro:before-swap', cleanup)
</script>

<style lang="scss">
  @use '../styles/scssVariables' as *;

  .study-header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    padding: var(--spacing-7);
    mix-blend-mode: difference;
  }

  .study-home-link {
    display: block;
    width: fit-content;
  }

  .study-slides {
    position: relative;
    z-index: 1;
    height: 100dvh;
    overflow-y: auto;
    scroll-snap-type: y mandatory;

    @media (width < $breakpoint-md) {
      height: auto;
      overflow-y: visible;
      scroll-snap-type: none;
    }
  }
</style>

<style lang="scss" is:global>
  @use '../styles/scssVariables' as *;

  // ========================================
  // Theme tokens
  // ========================================

  body.study-layout {
    --study-color: var(--page-color);

    background-color: var(--study-bg);
    color: var(--study-text);
  }

  // Revel — night navigation: dark map canvas, cyan routing accents
  body.study-theme--road {
    --study-bg: #060a12;
    --study-bg-alt: #0b1220;
    --study-surface: #0f1725;
    --study-surface-glass: rgba(160, 200, 245, 0.045);
    --study-text: #b3c2d8;
    --study-text-muted: #7285a1;
    --study-heading: #f2f7ff;
    --study-border: rgba(150, 185, 230, 0.16);
    --study-border-strong: rgba(150, 185, 230, 0.34);
    --study-road: #1d283d;
    --study-lane: rgba(214, 232, 255, 0.5);
    --study-heading-font: var(--font-body);
    --study-heading-weight: 700;
    --study-heading-tracking: -0.03em;
    --study-radius: 14px;
  }

  // Artemis — field guide: warm paper canvas, leaf and soil accents
  body.study-theme--field {
    --study-bg: #f7f3e9;
    --study-bg-alt: #efe7d6;
    --study-surface: #fffdf7;
    --study-surface-glass: rgba(255, 253, 247, 0.72);
    --study-text: #4b4034;
    --study-text-muted: #8b7e6c;
    --study-heading: #29211a;
    --study-border: #ded1ba;
    --study-border-strong: #c8b696;
    --study-leaf: #4d8a4f;
    --study-soil: #6f553a;
    --study-heading-font: var(--font-serif);
    --study-heading-weight: 600;
    --study-heading-tracking: -0.01em;
    --study-radius: 10px;
  }

  // ========================================
  // Slide shell
  // ========================================

  .study-slide {
    min-height: 100dvh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-12);
    overflow: hidden;
    position: relative;

    @media (width < $breakpoint-lg) {
      padding: var(--spacing-10) var(--spacing-12);
    }

    @media (width < $breakpoint-md) {
      min-height: auto;
      scroll-snap-align: none;
      padding: var(--spacing-14) var(--spacing-8);
    }

    @media (width < $breakpoint-sm) {
      padding: var(--spacing-12) var(--spacing-6);
    }
  }

  .slide-inner {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-12);
  }

  // --- Animation initial states (hidden until animated) ---

  .slide-heading,
  .slide-body,
  .slide-media,
  .slide-stagger-item {
    opacity: 0;
  }

  // ========================================
  // Slide typography
  // ========================================

  .slide-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-inline: var(--spacing-8);
  }

  .slide-heading {
    font-family: var(--study-heading-font);
    font-weight: var(--study-heading-weight);
    letter-spacing: var(--study-heading-tracking);
    font-size: clamp(1.85rem, 3.2vw, 2.75rem);
    line-height: 1.15;
    color: var(--study-heading);
  }

  .slide-section-label {
    font-family: var(--font-body);
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-4);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--study-color);
    line-height: 1;
    margin-bottom: var(--spacing-6);

    &::before,
    &::after {
      content: '';
      width: 18px;
      height: 1px;
      background: currentColor;
      opacity: 0.5;
    }

    .study-theme--road & {
      padding: var(--spacing-4) var(--spacing-7);
      border: 1px solid var(--study-border-strong);
      border-radius: 99px;
      background: var(--study-surface-glass);

      &::before,
      &::after {
        display: none;
      }
    }
  }

  .slide-subtitle {
    max-width: 56ch;
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    line-height: 1.65;
    color: var(--study-text-muted);
    font-weight: 400;
    margin-top: var(--spacing-7);
    text-wrap: balance;
  }

  // ========================================
  // Shared study card styles
  // ========================================

  .study-card {
    border: 1px solid var(--study-border);
    border-radius: var(--study-radius);
    overflow: hidden;
    flex: 1;

    .study-theme--road & {
      background: var(--study-surface-glass);
      backdrop-filter: blur(6px);
    }

    .study-theme--field & {
      background: var(--study-surface);
      box-shadow: 0 1px 0 var(--study-border-strong);
    }

    &--dashed {
      border-style: dashed;

      .study-theme--road & {
        background: rgba(160, 200, 245, 0.02);
      }
    }

    &--filled {
      .study-theme--road & {
        border-color: hsl(from var(--study-color) h s l / 0.55);
        background: hsl(from var(--study-color) h s l / 0.09);
        box-shadow: inset 0 0 40px hsl(from var(--study-color) h s l / 0.07);
      }

      .study-theme--field & {
        border-color: hsl(from var(--study-color) h s l / 0.5);
        border-style: solid;
        background: color-mix(in srgb, var(--study-color) 5%, var(--study-surface));
        box-shadow: inset 0 3px 0 var(--study-color);
      }
    }
  }

  .study-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-3);
    padding: var(--spacing-7) var(--spacing-8) var(--spacing-6);
  }

  .study-card-label {
    font-family: var(--study-heading-font);
    font-size: 1.35rem;
    font-weight: var(--study-heading-weight);
    color: var(--study-heading);
    letter-spacing: -0.01em;

    .study-card--filled & {
      color: var(--study-color);
    }
  }

  .study-card-tag {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--study-text-muted);
    border: 1px solid var(--study-border);
    border-radius: 99px;
    padding: 4px 9px;
    white-space: nowrap;

    .study-card--filled & {
      color: var(--study-color);
      border-color: hsl(from var(--study-color) h s l / 0.4);
    }
  }

  .study-card-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;

    li {
      font-size: 0.925rem;
      line-height: 1.55;
      color: var(--study-text);
      display: grid;
      grid-template-columns: 5.5rem 1fr;
      gap: var(--spacing-6);
      align-items: baseline;
      border-top: 1px dashed var(--study-border);
      padding: var(--spacing-6) var(--spacing-8);
      text-wrap: pretty;

      .study-card--filled & {
        color: var(--study-heading);
        border-top-color: hsl(from var(--study-color) h s l / 0.28);
      }
    }
  }

  .study-card-category {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--study-text-muted);

    .study-card--filled & {
      color: hsl(from var(--study-color) h s calc(l * 0.85));
    }
  }

  // ========================================
  // Shared viz card styles (result / decision cards)
  // ========================================

  .study-viz-card {
    text-align: left;
    border: 1px solid var(--study-border);
    border-radius: var(--study-radius);
    display: flex;
    flex-direction: column;
    overflow: hidden;

    .study-theme--road & {
      background: var(--study-surface-glass);
      backdrop-filter: blur(6px);
    }

    .study-theme--field & {
      background: var(--study-surface);
      box-shadow: 0 1px 0 var(--study-border-strong);
    }
  }

  .study-viz-card-viz {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-6);
    border-bottom: 1px solid var(--study-border);

    .study-theme--road & {
      background:
        radial-gradient(ellipse at 50% 120%, hsl(from var(--study-color) h s l / 0.12), transparent 70%),
        var(--study-bg-alt);
    }

    .study-theme--field & {
      background: var(--study-bg-alt);
      border-bottom-style: dashed;
    }
  }

  .study-viz-card-content {
    padding: var(--spacing-8);
  }

  .study-viz-card-number {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--study-color);
    letter-spacing: 0.06em;
    width: 26px;
    height: 26px;
    display: grid;
    place-content: center;
    border-radius: 50%;
    background: hsl(from var(--study-color) h s l / 0.12);
    flex-shrink: 0;
    margin-bottom: var(--spacing-4);
  }

  .study-viz-card-title {
    font-family: var(--study-heading-font);
    font-size: 1.1rem;
    font-weight: var(--study-heading-weight);
    color: var(--study-heading);
    margin-bottom: var(--spacing-5);
  }

  .study-viz-card-body {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--study-text-muted);
    text-wrap: pretty;
  }

  // ========================================
  // Shared quote styles
  // ========================================

  .study-quote {
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--study-text);
    margin: 0;

    .study-theme--field & {
      font-family: var(--font-serif);
      font-style: italic;
    }

    .study-theme--road & {
      padding-left: var(--spacing-7);
      border-left: 2px solid hsl(from var(--study-color) h s l / 0.5);
    }
  }

  .study-cite {
    font-size: 0.75rem;
    font-style: normal;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--study-text-muted);
    margin: 0;

    .study-theme--road & {
      padding-left: var(--spacing-7);
    }
  }
</style>
