---
import StudyLayout from '@layouts/StudyLayout.astro'
import RouteNav from '@components/study/RouteNav.astro'
import GmapsImg from '@media/revel/mapping/gmaps-bg.png'
import HeroHeatmap from '@media/revel/mapping/HeroHeatmap.astro'
import CarTopdown from '@media/revel/mapping/revel-tesla-top.png'
import { Image } from 'astro:assets'
import OperationsMap from '@media/revel/mapping/operations-map.png'
import StudyCarousel from '@components/StudyCarousel.astro'
import DecisionAbsolute from '@media/revel/mapping/DecisionAbsolute.astro'
import DecisionTravelTime from '@media/revel/mapping/DecisionTravelTime.astro'
import DecisionCadence from '@media/revel/mapping/DecisionCadence.astro'
import ResultsRevenue from '@media/revel/mapping/ResultsRevenue.astro'
import ResultsWaitTime from '@media/revel/mapping/ResultsWaitTime.astro'
import ResultsAdoption from '@media/revel/mapping/ResultsAdoption.astro'

const slides = [
  { id: 'hero', title: 'Remapping Revel' },
  { id: 'w2-to-1099', title: 'Changing Contracts' },
  { id: 'drivers', title: 'Drivers: Where & Why' },
  { id: 'map-design-system', title: 'Map Design System' },
  { id: 'visualizations', title: 'Demanding Visualizations' },
  { id: 'decisions', title: 'Key Design Decisions' },
  { id: 'results', title: 'Results' },
  { id: 'next', title: 'What Comes Next' },
]

// H3-style hex field used behind the exploration carousel
const hexRadius = 21
const hexWidth = Math.sqrt(3) * hexRadius
const hexPoints = [
  [0, -hexRadius],
  [hexWidth / 2, -hexRadius / 2],
  [hexWidth / 2, hexRadius / 2],
  [0, hexRadius],
  [-hexWidth / 2, hexRadius / 2],
  [-hexWidth / 2, -hexRadius / 2],
]
  .map(([x, y]) => `${x.toFixed(2)},${y.toFixed(2)}`)
  .join(' ')

const hexes = Array.from({ length: 15 }, (_, row) =>
  Array.from({ length: 46 }, (_, col) => {
    const x = col * hexWidth + (row % 2 ? hexWidth / 2 : 0)
    const y = row * hexRadius * 1.5
    // Deterministic pseudo-random weight so the field reads like demand data
    const weight = (Math.sin(row * 12.9898 + col * 78.233) * 43758.5453) % 1
    return { x, y, weight: Math.abs(weight) }
  }),
).flat()
---

<StudyLayout title="Remapping Revel" color="rgb(1, 185, 242)" theme="road" slides={slides}>
  <RouteNav slides={slides} slot="nav" />

  <!-- Slide 1: Hero -->
  <section class="study-slide slide-hero" id="hero">
    <div class="slide-inner">
      <div class="slide-header">
        <p class="slide-body hero-eyebrow">
          <span class="hero-eyebrow-dot"></span>Revel Rideshare &middot; New York City
        </p>
        <h1 class="slide-body hero-title">Remapping Revel</h1>
        <div class="slide-body hero-meta">
          <span class="hero-chip">Lead Product Designer</span>
          <span class="hero-chip">2022 &ndash; 2025</span>
        </div>
        <p class="slide-media hero-summary">
          I led design on creating a new mapping system used across all of Revel's products, and spearheaded demand
          heatmaps that helped drivers find more rides and improve their earnings.
        </p>
      </div>
      <div class="hero-visual">
        <div class="hero-frame">
          <div class="hero-screen">
            <img src={GmapsImg.src} alt="" class="hero-map-img" width={GmapsImg.width} height={GmapsImg.height} />
            <HeroHeatmap class="hero-heatmap" />
            <div class="hero-sweep"></div>
          </div>
          <div class="hero-scrim"></div>
        </div>
        <p class="hero-caption"><span class="hero-caption-pulse"></span>Driver demand heatmap &middot; Manhattan &amp; Queens</p>
      </div>
    </div>
  </section>

  <!-- Slide 2: W2 to 1099 -->
  <section class="study-slide" id="w2-to-1099">
    <div class="slide-inner">
      <div class="slide-header">
        <p class="slide-section-label slide-body">Context</p>
        <h2 class="slide-heading">Changing Contracts</h2>
        <p class="slide-body slide-subtitle">
          Revel Rideshare changed from salaried drivers to independent contractors, significantly changing driver
          incentives and limiting operation's ability to control driver distribution.
        </p>
      </div>
      <div class="lane-rows">
        <div class="lane-row">
          <div class="slide-stagger-item study-card study-card--dashed">
            <div class="study-card-header">
              <span class="study-card-label">W2</span>
              <span class="study-card-tag">Employee</span>
            </div>
            <ul class="study-card-list">
              <li>
                <span class="study-card-category">Pay</span>
                Hourly salary with a predictable weekly paycheck
              </li>
              <li>
                <span class="study-card-category">Scheduling</span>
                Fixed shifts assigned and managed by Revel
              </li>
              <li>
                <span class="study-card-category">Incentives</span>
                Rides per shift only impacted bonuses
              </li>
            </ul>
          </div>

          <div class="lane-switch" aria-hidden="true">
            <span class="lane-switch-dashes"></span>
            <svg class="lane-switch-chevron" viewBox="0 0 16 16" fill="none">
              <path d="m5 3 5 5-5 5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>

          <div class="slide-stagger-item study-card study-card--filled">
            <div class="study-card-header">
              <span class="study-card-label">1099</span>
              <span class="study-card-tag">Contractor</span>
            </div>
            <ul class="study-card-list">
              <li>
                <span class="study-card-category">Pay</span>
                Per-ride earnings plus tips and completion bonuses
              </li>
              <li>
                <span class="study-card-category">Scheduling</span>
                Self-selected hours with high flexibility over shift times
              </li>
              <li>
                <span class="study-card-category">Incentives</span>
                More rides per hour directly increases earnings
              </li>
            </ul>
          </div>
        </div>

        <div class="lane-row">
          <div class="slide-stagger-item study-card study-card--dashed">
            <div class="study-card-header">
              <span class="study-card-label">Mapbox</span>
              <span class="study-card-tag">Before</span>
            </div>
            <ul class="study-card-list">
              <li>
                <span class="study-card-category">Cost</span>
                Expensive per-load pricing with limited scalability
              </li>
              <li>
                <span class="study-card-category">Data</span>
                Outdated place data and missing search results
              </li>
              <li>
                <span class="study-card-category">Support</span>
                No existing vendor relationship to fall back on
              </li>
            </ul>
          </div>

          <div class="lane-switch" aria-hidden="true">
            <span class="lane-switch-dashes"></span>
            <svg class="lane-switch-chevron" viewBox="0 0 16 16" fill="none">
              <path d="m5 3 5 5-5 5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>

          <div class="slide-stagger-item study-card study-card--filled">
            <div class="study-card-header">
              <span class="study-card-label">Google Maps</span>
              <span class="study-card-tag">After</span>
            </div>
            <ul class="study-card-list">
              <li>
                <span class="study-card-category">Cost</span>
                Lower pricing via an existing Google relationship
              </li>
              <li>
                <span class="study-card-category">Data</span>
                Smarter search and up-to-date place data
              </li>
              <li>
                <span class="study-card-category">Support</span>
                Better support through an established vendor agreement
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Slide 3: Drivers: Where & Why -->
  <section class="study-slide" id="drivers">
    <div class="slide-inner">
      <div class="slide-header">
        <p class="slide-section-label slide-body">Research</p>
        <h2 class="slide-heading">Drivers: Where &amp; Why</h2>
        <p class="slide-body slide-subtitle">
          Driver distribution is a complex problem space involving experience, financial incentives, traffic, weather,
          and more. Along with my PM, I worked closely with drivers, operations, and analytics to better understand
          where drivers were going.
        </p>
      </div>
      <div class="research-grid">
        <div class="slide-stagger-item study-card study-card--dashed research-card">
          <div class="study-card-header">
            <span class="study-card-label"><span class="research-pin"></span>Interviews</span>
            <span class="study-card-tag">Research</span>
          </div>
          <ul class="study-card-list">
            <li>
              <span class="study-card-category">Drivers</span>
              New and experienced Revel drivers, some who had driven for competing platforms
            </li>
            <li>
              <span class="study-card-category">Focus</span>
              What were the most important factors in where drivers chose to position between rides
            </li>
          </ul>
          <div class="card-finding">
            <p class="study-quote">
              "We had bonuses on the map where you got more rides, I followed sometimes, but I know the city"
            </p>
            <p class="study-cite">New Revel driver, 4 years at Uber</p>
          </div>
        </div>

        <div class="slide-stagger-item study-card study-card--dashed research-card">
          <div class="study-card-header">
            <span class="study-card-label"><span class="research-pin"></span>Operations</span>
            <span class="study-card-tag">Observation</span>
          </div>
          <ul class="study-card-list">
            <li>
              <span class="study-card-category">Setting</span>
              On-site sitting with operations team and maintenance teams
            </li>
            <li>
              <span class="study-card-category">Focus</span>
              Nuances of how operations used existing map and distribution tools so nothing would be lost in transition
            </li>
          </ul>
          <div class="card-finding card-finding--flush">
            <Image
              src={OperationsMap}
              alt="Revel operations map showing fleet distribution across the service area"
              layout="full-width"
              fit="cover"
            />
          </div>
        </div>

        <div class="slide-stagger-item study-card study-card--dashed research-card">
          <div class="study-card-header">
            <span class="study-card-label"><span class="research-pin"></span>Analytics</span>
            <span class="study-card-tag">Data</span>
          </div>
          <ul class="study-card-list">
            <li>
              <span class="study-card-category">Data</span>
              Supply and demand distribution, zone supply response time, driver idle time
            </li>
            <li>
              <span class="study-card-category">Focus</span>
              What metrics were suffering from the new contractor model and which we should prioritize
            </li>
          </ul>
          <div class="card-finding card-finding--chart">
            <p class="chart-title">Zone supply response time</p>
            <svg class="chart-svg" viewBox="0 0 300 115" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <defs>
                <linearGradient id="demand-fill" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="var(--study-color)" stop-opacity="0.35"></stop>
                  <stop offset="1" stop-color="var(--study-color)" stop-opacity="0"></stop>
                </linearGradient>
              </defs>
              <line x1="0" y1="98" x2="300" y2="98" stroke="currentColor" stroke-width="1" opacity="0.35"></line>
              <line x1="0" y1="36" x2="300" y2="36" stroke="currentColor" stroke-width="0.5" stroke-dasharray="3 3" opacity="0.2"></line>
              <line x1="0" y1="67" x2="300" y2="67" stroke="currentColor" stroke-width="0.5" stroke-dasharray="3 3" opacity="0.2"></line>
              <path
                d="M0,98 L0,80 Q75,31 100,45 Q116,58 133,56 Q150,54 167,61 Q183,68 200,43 Q218,17 233,29 Q250,41 267,52 Q283,63 300,85 L300,98 Z"
                fill="url(#demand-fill)"></path>
              <path
                class="chart-line chart-line--demand"
                d="M0,80 Q75,31 100,45 Q116,58 133,56 Q150,54 167,61 Q183,68 200,43 Q218,17 233,29 Q250,41 267,52 Q283,63 300,85"
                stroke="var(--study-color)"
                stroke-width="2"
                stroke-linecap="round"></path>
              <path
                class="chart-line chart-line--supply"
                d="M0,84 Q93,45 113,52 Q130,60 148,58 Q165,57 183,64 Q200,70 220,46 Q240,35 255,44 Q270,53 284,64 Q293,72 300,87"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-dasharray="4 2"
                opacity="0.7"></path>
              <text x="10" y="110" text-anchor="start" font-size="8" font-family="inherit" fill="currentColor" opacity="0.7">7am</text>
              <text x="75" y="110" text-anchor="middle" font-size="8" font-family="inherit" fill="currentColor" opacity="0.7">11am</text>
              <text x="150" y="110" text-anchor="middle" font-size="8" font-family="inherit" fill="currentColor" opacity="0.7">3pm</text>
              <text x="225" y="110" text-anchor="middle" font-size="8" font-family="inherit" fill="currentColor" opacity="0.7">7pm</text>
              <text x="290" y="110" text-anchor="end" font-size="8" font-family="inherit" fill="currentColor" opacity="0.7">11pm</text>
            </svg>
            <div class="chart-legend">
              <span class="chart-legend-item chart-legend-item--demand">Rider demand</span>
              <span class="chart-legend-item chart-legend-item--supply">Driver supply</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Slide 4: Map Design System -->
  <section class="study-slide slide-design-system" id="map-design-system">
    <div class="slide-inner">
      <div class="slide-header">
        <p class="slide-section-label slide-body">Scalability</p>
        <h2 class="slide-heading">Map Design System</h2>
        <p class="slide-body slide-subtitle">
          Existing Mapbox implementations were custom for each Revel app. Consolidating shared concepts and components
          into a new map design system would reduce refactoring time, accelerate future development, and make the user
          experience more consistent.
        </p>
      </div>
      <div class="route-designs">
        <!-- Operations -->
        <div class="route-design">
          <p class="route-design-label">Operations</p>
          <div class="route-line route-line--ops">
            <div class="route-track"><span class="route-sweep"></span></div>
            <span class="route-el route-dot route-dot--gray route-dot--lg" style="left: 2%"></span>
            <span class="route-el route-car" style="left: 22%">
              <Image src={CarTopdown} alt="" width="64" height="64" layout="constrained" />
            </span>
            <span class="route-el route-dot route-dot--blue" style="left: 52%"></span>
            <span class="route-el route-dot route-dot--blue route-dot--lg" style="left: 98%"></span>
          </div>
        </div>

        <!-- Driver / Ride Request + Traffic -->
        <div class="route-design">
          <p class="route-design-label">Driver / Ride Request + Traffic</p>
          <div class="route-line route-line--traffic">
            <div class="route-track"><span class="route-sweep"></span></div>
            <span class="route-el route-car" style="left: 3%">
              <Image src={CarTopdown} alt="" width="64" height="64" layout="constrained" />
            </span>
            <span class="route-el route-action route-action--pickup" style="left: 32%">
              <svg viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M7 12V5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-dasharray="2 2.5"></path>
                <path d="M3.5 7.5L7 3.5L10.5 7.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
            <span class="route-el route-dot route-dot--blue" style="left: 65%"></span>
            <span class="route-el route-action route-action--dropoff" style="left: 98%">
              <svg viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M7 2V9" stroke="white" stroke-width="2" stroke-linecap="round" stroke-dasharray="2 2.5"></path>
                <path d="M3.5 6.5L7 10.5L10.5 6.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </div>
        </div>

        <!-- Driver / In-Ride -->
        <div class="route-design">
          <p class="route-design-label">Driver / In-Ride</p>
          <div class="route-line route-line--inride">
            <div class="route-track" style="left: 22%"><span class="route-sweep"></span></div>
            <span class="route-el route-car" style="left: 22%">
              <Image src={CarTopdown} alt="" width="64" height="64" layout="constrained" />
            </span>
            <span class="route-pin" style="left: 47%">
              <span class="route-pin-head"></span>
              <span class="route-pin-stem"></span>
            </span>
            <span class="route-el route-dot route-dot--blue route-dot--lg" style="left: 52%"></span>
            <span class="route-profile" style="left: 52%">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="8" r="3.5" stroke="white" stroke-width="2"></circle>
                <path d="M6 21C6 17.134 8.68629 14 12 14C15.3137 14 18 17.134 18 21" stroke="white" stroke-width="2" stroke-linecap="round"></path>
              </svg>
            </span>
            <span class="route-el route-dot route-dot--gray" style="left: 78%"></span>
            <span class="route-el route-dot route-dot--gray route-dot--lg" style="left: 98%"></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Slide 5: Demanding Visualizations -->
  <section class="study-slide slide-visualizations" id="visualizations">
    <svg class="hex-field" viewBox="0 0 1600 470" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs><polygon id="demand-hex" points={hexPoints}></polygon></defs>
      {
        hexes.map((hex, i) => (
          <use
            href="#demand-hex"
            x={hex.x}
            y={hex.y}
            class:list={['hex', { 'hex--hot': hex.weight > 0.82 }]}
            style={`--hex-opacity: ${(0.02 + hex.weight * 0.1).toFixed(3)}; --hex-delay: ${((i % 17) * 0.42).toFixed(2)}s`}
          />
        ))
      }
    </svg>
    <div class="slide-inner">
      <div class="slide-header">
        <p class="slide-section-label slide-body">Exploration</p>
        <h2 class="slide-heading">Demanding Visualizations</h2>
        <p class="slide-body slide-subtitle">
          Revel's data team had been using Uber's H3 hexagon spatial indexing to map supply/demand data. I was able to
          take a snapshot of that data and translate it into vectors I could experiment with in Figma.
        </p>
      </div>
      <div class="carousel-tabs-wrap">
        <div class="carousel-tabs" style="--tab-index: 0">
          <span class="carousel-tab-indicator" aria-hidden="true"></span>
          <button class="carousel-tab carousel-tab--active" data-target="carousel-mobile">Driver</button>
          <button class="carousel-tab" data-target="carousel-desktop">Operations</button>
        </div>
        <div id="carousel-mobile" class="carousel-panel">
          <StudyCarousel folder="revel/mapping/exploration/mobile" />
        </div>
        <div id="carousel-desktop" class="carousel-panel carousel-panel--hidden">
          <StudyCarousel folder="revel/mapping/exploration/desktop" width={600} />
        </div>
      </div>
    </div>
  </section>

  <!-- Slide 6: Key Design Decisions -->
  <section class="study-slide slide-decisions" id="decisions">
    <div class="slide-inner">
      <div class="slide-header">
        <p class="slide-section-label slide-body">Execution</p>
        <h2 class="slide-heading">Key Design Decisions</h2>
        <p class="slide-body slide-subtitle">
          Making the heatmap trustworthy and usable while driving involved more than visual design. Deciding which data
          levers would impact demand representation had a significant impact on how the map felt.
        </p>
      </div>
      <div class="decision-cards">
        <div class="slide-stagger-item study-viz-card">
          <div class="study-viz-card-viz decision-card-viz">
            <DecisionAbsolute />
          </div>
          <div class="study-viz-card-content">
            <div class="study-viz-card-number">01</div>
            <h3 class="study-viz-card-title">Absolute Demand</h3>
            <p class="study-viz-card-body">
              Initially the team felt relative demand would be a smart way to show drivers where the most relevant
              demand was, but I was convinced it would be confusing for drivers to have zones constantly change as they
              moved.
            </p>
          </div>
        </div>
        <div class="slide-stagger-item study-viz-card">
          <div class="study-viz-card-viz decision-card-viz">
            <DecisionTravelTime />
          </div>
          <div class="study-viz-card-content">
            <div class="study-viz-card-number">02</div>
            <h3 class="study-viz-card-title">Travel-Time Weighted</h3>
            <p class="study-viz-card-body">
              Sometimes a nearby high demand zone has a long travel time or high traffic. We factored in Google's more
              accurate travel time data to adjust the demand score and encourage drivers to go to the fastest
              high-demand zone.
            </p>
          </div>
        </div>
        <div class="slide-stagger-item study-viz-card">
          <div class="study-viz-card-viz decision-card-viz">
            <DecisionCadence />
          </div>
          <div class="study-viz-card-content">
            <div class="study-viz-card-number">03</div>
            <h3 class="study-viz-card-title">Update Cadence</h3>
            <p class="study-viz-card-body">
              Our supply and demand data updated every minute, but this made the map feel unstable just like relative
              demand. We settled on a 10-minute update cadence with some averaging over time to provide data that was up
              to date but not as variable.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Slide 7: Results -->
  <section class="study-slide slide-results" id="results">
    <div class="slide-inner">
      <div class="slide-header">
        <p class="slide-section-label slide-body">Outcomes</p>
        <h2 class="slide-heading">Results</h2>
        <p class="slide-body slide-subtitle">
          Reworking maps across Revel saw impacts in numerous areas of the business, but the most significant were in
          driver revenue and passenger wait times that soon recovered and exceeded pre-heatmap levels.
        </p>
      </div>
      <div class="results-cards">
        <div class="slide-stagger-item study-viz-card">
          <div class="study-viz-card-viz result-card-viz">
            <ResultsRevenue />
          </div>
          <div class="study-viz-card-content">
            <div class="study-viz-card-number">01</div>
            <h3 class="study-viz-card-title">Revenue Per Hour</h3>
            <p class="study-viz-card-body">
              Average driver revenue per hour increased 7% after heatmap release, with newer drivers seeing gains up to
              10% as the map closed the knowledge gap with veteran drivers.
            </p>
          </div>
        </div>
        <div class="slide-stagger-item study-viz-card">
          <div class="study-viz-card-viz result-card-viz">
            <ResultsWaitTime />
          </div>
          <div class="study-viz-card-content">
            <div class="study-viz-card-number">02</div>
            <h3 class="study-viz-card-title">Passenger Wait Time</h3>
            <p class="study-viz-card-body">
              Average passenger wait time dropped 3 minutes as drivers spread more evenly across demand zones instead of
              clustering in familiar areas.
            </p>
          </div>
        </div>
        <div class="slide-stagger-item study-viz-card">
          <div class="study-viz-card-viz result-card-viz">
            <ResultsAdoption />
          </div>
          <div class="study-viz-card-content">
            <div class="study-viz-card-number">03</div>
            <h3 class="study-viz-card-title">Heatmap Adoption</h3>
            <p class="study-viz-card-body">
              70% of new drivers used the heatmap regularly after discovering it. Experienced drivers adopted at 40%,
              tapering as they internalized demand patterns.
            </p>
          </div>
        </div>
      </div>
      <blockquote class="result-blockquote slide-stagger-item">
        <p class="study-quote">
          &ldquo;I still head to my regular spots, but I'll take a ride to a hot-zone if it's closer and faster.&rdquo;
        </p>
